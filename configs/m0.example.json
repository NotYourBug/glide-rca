{
  "environment_id": "demo-local",
  "prometheus_url": "http://127.0.0.1:9090",
  "opensearch_url": "http://127.0.0.1:9200",
  "jaeger_url": "http://127.0.0.1:8080/jaeger/ui/api/v3",
  "service": "payment",
  "resource_label": "container_name",
  "resource_value": "ad",
  "log_service_field": "resource.service.name.keyword",
  "log_index_pattern": "otel-logs-v2-*",
  "metric_queries": {
    "request_rate": "sum(rate(traces_span_metrics_calls_total{service_name=\"payment\",span_kind=\"SPAN_KIND_SERVER\"}[5m]))",
    "error_rate": "sum(rate(traces_span_metrics_calls_total{service_name=\"payment\",span_kind=\"SPAN_KIND_SERVER\",status_code=\"STATUS_CODE_ERROR\"}[5m])) / sum(rate(traces_span_metrics_calls_total{service_name=\"payment\",span_kind=\"SPAN_KIND_SERVER\"}[5m]))",
    "latency_p95_ms": "histogram_quantile(0.95, sum by(le)(rate(traces_span_metrics_duration_milliseconds_bucket{service_name=\"payment\",span_kind=\"SPAN_KIND_SERVER\"}[5m])))",
    "ad_cpu": "container_cpu_utilization_ratio{container_name=\"ad\"}",
    "ad_memory_bytes": "container_memory_usage_total_bytes{container_name=\"ad\"}"
  }
}
